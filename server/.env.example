# Placeholder values only. Copy to a local, untracked environment and replace them;
# never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://gossa_app:change-me@localhost:5432/gossa

# Number of reverse-proxy hops to trust (0 for local development).
TRUST_PROXY=0

# Optional tuning (defaults shown).
# DB_POOL_MAX=10
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOG_LEVEL=info

# Tests use a separate, disposable database whose name contains "test".
# The suite truncates every table in it.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/gossa_test

# Read only by `npm --prefix server run bootstrap:owner` when it is not run in a terminal.
# Set GOSSA_OWNER_PASSWORD (12-128 characters) in your shell or secret store, not in this file.
# GOSSA_GARAGE_NAME=Northside Garage
# GOSSA_GARAGE_TIMEZONE=UTC
# GOSSA_OWNER_NAME=Owner User
# GOSSA_OWNER_EMAIL=owner@example.com
